# ---- how this bot is launched (values are NOT stored here) ----
# Copy to .env, fill in, then:  chmod 600 .env
# .env is git-ignored. Never commit real credentials.

# Exness MT5 demo account (the official MetaTrader5 python package, under Wine)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: terminal64.exe path under the Wine prefix. REQUIRED in practice —
# attaching without a path gives (-10005, 'IPC timeout') even with valid creds.
MT5_PATH=

# Which account the bot may touch. The engine refuses to trade when this is not
# "demo" unless --i-know-this-is-live is passed on the command line.
ENVIRONMENT=demo

# Optional alerting (core/alerts.py). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
