# credentials — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# live/runtime state
logs/
*.log
*.out
data/*.db-wal
data/*.db-shm
*.sqlite3

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# research exports: 200 MB of MT5 CSV, regenerated by research/export_data.py
# research/data/ is created by export_data.py (or symlinked to your own exports).
research/data/
research/data/*.csv

# NOTE: research/results.json IS committed on purpose (~50 KB). It is the raw
# output behind every backtest number in the README, so it has to be checkable
# without re-running the harness. Regenerate with:
#   python research/edge_harness.py --json research/results.json

# os / editor
.DS_Store
.idea/
.vscode/
